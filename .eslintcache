 = ({ history }) => {\n  const [formData, setFormData] = useState({\n    email: \"\",\n    password: \"\",\n  });\n\n  const dispatch = useDispatch();\n  const { loading , user} = useSelector((s) => s.Auth);\n\n  const { email, password } = formData;\n\n  const fornmHandler = (e) => {\n    setFormData({ ...formData, [e.target.name]: e.target.value });\n    console.log(formData);\n  };\n\n  const signInHandler = (e) => {\n    e.preventDefault();\n\n    if (!email) {\n      errorNotification(\"Email Required\");\n      return;\n    }\n    if (!password) {\n      errorNotification(\"Password Required\");\n      return;\n    }\n\n    dispatch(userSignin(history, formData));\n  };\n\n  useEffect(() => {\n    if(user){\n      history.push('/setting-dsh')\n    }\n  },[])\n  return (\n    <div className=\"container-fluid\">\n      <div className=\"row\">\n        <div\n          className=\"col-12 sign-in-form\"\n          data-aos-easing=\"linear\"\n          data-aos-duration=\"700\"\n        >\n          <form>\n            <h5>Sign in</h5>\n            <div className=\"form-group\">\n              <input\n                type=\"email\"\n                className=\"form-control\"\n                id=\"email\"\n                placeholder=\"Email\"\n                name=\"email\"\n                onChange={(e) => fornmHandler(e)}\n                value={email}\n              />\n            </div>\n            <div className=\"form-group\">\n              <input\n                type=\"password\"\n                className=\"form-control\"\n                id=\"password\"\n                placeholder=\"Password\"\n                name=\"password\"\n                onChange={(e) => fornmHandler(e)}\n                value={password}\n              />\n            </div>\n            <div className=\"sign-in-up\">\n              <div className=\"sign-in\">\n                <button disabled={loading} onClick={(e) => signInHandler(e)} className=\"btn\">\n                  Sign in\n                </button>\n                <span className=\"sign-up\">\n                  {\" \"}\n                  or <Link to=\"/signup\">sign up</Link>{\" \"}\n                </span>\n              </div>\n              <div className=\"forgot-pwd\">\n                <a href=\"#\">Forgot Password?</a>\n              </div>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Signin;\n","/Users/umermughal/Umer's Work/Office Work/logic_crypto/src/screens/SettingDashboard.js",["320","321","322","323","324","325"],"import React from \"react\";\nimport Carousel from \"../components/Carousel\";\nimport Sidebar from \"../components/Sidebar\";\n\nconst SettingDashboard = () => {\n  return (\n    <div className=\"container-fluid\">\n      <div className=\"row\">\n        <div className=\"col-md-12 p-0\">\n          <div className=\"s-layout\">\n            <Sidebar />\n            <main className=\"s-layout__content\">\n              <div className=\"container-fluid\">\n                <div className=\"row exchange\">\n                  <div className=\"col-md-12\">\n                    <h2>Settings</h2>\n                    <ul\n                      className=\"nav nav-pills mb-3\"\n                      id=\"crypto-tab\"\n                      role=\"tablist\"\n                    >\n                      <li className=\"nav-item\">\n                        <a\n                          className=\"nav-link active\"\n                          id=\"pills-profile-tab\"\n                          data-toggle=\"pill\"\n                          href=\"#pills-profile\"\n                          role=\"tab\"\n                          aria-controls=\"pills-profile\"\n                          aria-selected=\"true\"\n                        >\n                          Profile\n                        </a>\n                      </li>\n                      <li className=\"nav-item\">\n                        <a