       <span class=\"heading green\">Jan 20</span>\r\n                          <br />\r\n                          <div class=\"milestones vertical-line left\">\r\n                            <span class=\"text-right\">\r\n                              Released new Trading Interface, allowing Traders\r\n                              to build more than 7,000 different automated\r\n                              strategies and started generating Revenue with a\r\n                              team of 8\r\n                            </span>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                      <div class=\"row clearfix left\">\r\n                        <div class=\"col-lg-5 box left second reveal\">\r\n                          <div class=\"dots pull-right\"></div>\r\n                          <br />\r\n                          <span class=\"heading green\">May 21</span>\r\n                          <br />\r\n                          <div class=\"milestones vertical-line right\">\r\n                            <span class=\"text-right\">\r\n                              Started offering the easiest Backtesting solution\r\n                              in the market and kicked off Seed Fundraising\r\n                              Campaign\r\n                            </span>\r\n                          </div>\r\n                        </div>\r\n                        <div class=\"col-lg-2\">\r\n                          <div class=\"lines second\">\r\n                            <div class=\"roadmap-line\"></div>\r\n                            <div class=\"roadmap-line\"></div>\r\n                          </div>\r\n                        </div>\r\n                        <div class=\"col-lg-5 box right second reveal\">\r\n                          <div class=\"dots pull-left\"></div>\r\n                          <br />\r\n                          <span class=\"heading green\">June 21</span>\r\n                          <br />\r\n                          <div class=\"milestones vertical-line left\">\r\n                            <span class=\"text-right\">\r\n                              Released new Trading Interface, allowing Traders\r\n                              to build more than 7,000 different automated\r\n                              strategies and started generating Revenue with a\r\n                              team of 8\r\n                            </span>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                      <div class=\"row clearfix left\">\r\n                        <div class=\"col-lg-5 box left third reveal\">\r\n                          <div class=\"dots pull-right\"></div>\r\n                          <br />\r\n                          <span class=\"heading green\">Aug 21</span>\r\n                          <br />\r\n                          <div class=\"milestones vertical-line right\">\r\n                            <span class=\"text-right\">\r\n                              Expanding asset classes offering by giving access\r\n                              for our trader community to stocks and commodities\r\n                              as well as initiating the workflow for the DeFi\r\n                              Proof of Concept\r\n                            </span>\r\n                          </div>\r\n                        </div>\r\n                        <div class=\"col-lg-2\">\r\n                          <div class=\"lines third\">\r\n                            <div class=\"roadmap-line\"></div>\r\n                            <div class=\"roadmap-line\"></div>\r\n                          </div>\r\n                        </div>\r\n                        <div class=\"col-lg-5 box right third reveal\">\r\n                          <div class=\"dots pull-left\"></div>\r\n                          <br />\r\n                     