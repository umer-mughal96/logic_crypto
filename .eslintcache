n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Accumulation</a>\r\n                        </li>\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div className=\"card\">\r\n                  <div className=\"card-header\" id=\"faqhead2\">\r\n                    <a\r\n                      href=\"#\"\r\n                      className=\"btn btn-header-link collapsed\"\r\n                      data-toggle=\"collapse\"\r\n                      data-target=\"#faq2\"\r\n                      aria-expanded=\"true\"\r\n                      aria-controls=\"faq2\"\r\n                    >\r\n                      Exchange Guidelines\r\n                    </a>\r\n                  </div>\r\n\r\n                  <div\r\n                    id=\"faq2\"\r\n                    className=\"collapse\"\r\n                    aria-labelledby=\"faqhead2\"\r\n                    data-parent=\"#faq\"\r\n                  >\r\n                    <div className=\"card-body\">\r\n                      <ul>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with the RSI</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with Moving Averges</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Contrarian</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Trend Following</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Accumulation</a>\r\n                        </li>\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div className=\"card\">\r\n                  <div className=\"card-header\" id=\"faqhead3\">\r\n                    <a\r\n                      href=\"#\"\r\n                      className=\"btn btn-header-link collapsed\"\r\n                      data-toggle=\"collapse\"\r\n                      data-target=\"#faq3\"\r\n                      aria-expanded=\"true\"\r\n                      aria-controls=\"faq3\"\r\n                    >\r\n                      Trading Tips\r\n                    </a>\r\n                  </div>\r\n\r\n                  <div\r\n                    id=\"faq3\"\r\n                    className=\"collapse\"\r\n                    aria-labelledby=\"faqhead3\"\r\n                    data-parent=\"#faq\"\r\n                  >\r\n                    <div className=\"card-body\">\r\n                      <ul>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with the RSI</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with Moving Averges</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Contrarian</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Trend Following</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Accumulation</a>\r\n                        </li>\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div className=\"card\">\r\n                  <div className=\"card-header\" id=\"faqhead4\">\r\n                    <a\r\n                      href=\"#\"\r\n                      className=\"btn btn-header-link collapsed\"\r\n                      data-toggle=\"collapse\"\r\n                      data-target=\"#faq4\"\r\n                      aria-expanded=\"true\"\r\n                      aria-controls=\"faq4\"\r\n                    >\r\n                      Trading Ideas\r\n                    </a>\r\n                  </div>\r\n\r\n                  <div\r\n                    id=\"faq4\"\r\n                    className=\"collapse\"\r\n                    aria-labelledby=\"faqhead4\"\r\n                    data-parent=\"#faq\"\r\n                  >\r\n                    <div className=\"card-body\">\r\n                      <ul>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with the RSI</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with Moving Averges</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Contrarian</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Trend Following</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Accumulation</a>\r\n                        </li>\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div className=\"card\">\r\n                  <div className=\"card-header\" id=\"faqhead5\">\r\n                    <a\r\n                      href=\"#\"\r\n                      className=\"btn btn-header-link collapsed\"\r\n                      data-toggle=\"collapse\"\r\n                      data-target=\"#faq5\"\r\n                      aria-expanded=\"true\"\r\n                      aria-controls=\"faq5\"\r\n                    >\r\n                      Trading View Strategies\r\n                    </a>\r\n                  </div>\r\n\r\n                  <div\r\n                    id=\"faq5\"\r\n                    className=\"collapse\"\r\n                    aria-labelledby=\"faqhead5\"\r\n                    data-parent=\"#faq\"\r\n                  >\r\n                    <div className=\"card-body\">\r\n                      <ul>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with the RSI</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">How to Trade with Moving Averges</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Contrarian</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Trend Following</a>\r\n                        </li>\r\n                        <li>\r\n                          <a href=\"\">Accumulation</a>\r\n                        </li>\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-md-8\">\r\n            <div className=\"risk-wrapper-text\">\r\n              <h2>Risk Management</h2>\r\n              <p>\r\n                One of the most important aspects of implementing an automatic\r\n                trading strategy is to prevent significant losses that will\r\n                potentially compromise a trader’s capital over the long-term.\r\n                Before making money, it’s important to learn how to protect your\r\n                crypto portfolio\r\n              </p>\r\n              <h2>First rule of Trading: Cut off losses!</h2>\r\n              <p>\r\n                What is usually the biggest challenge for a trader is to realise\r\n                and accept that a trade is not going in the expected direction.\r\n              </p>\r\n              <p>\r\n                Most traders focus on learning when to start a trade but don’t\r\n                put enough effort on the exit strategy.\r\n              </p>\r\n              <p>\r\n                Risk management protects your crypto portfolio and prevents from\r\n                further losses. However, it is crucial for the long-term success\r\n                of any trader to understand that cutting a loss at the right\r\n                time can be a move as successful as selling a coin at a profit.\r\n              </p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"container-fluid crypto-container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12 update-form\">\r\n            <h1>Getting Started Is Easy!</h1>\r\n            <p>Sign Up Today or Simply Get Market Updates In Your Inbox</p>\r\n            <form\r\n              action=\"\"\r\n              method=\"GET\"\r\n              id=\"update-form\"\r\n              style={{ position: \"relative\" }}\r\n            >\r\n              <input\r\n                className=\"form-control my-0 py-1 amber-border\"\r\n                type=\"email\"\r\n                placeholder=\"Email Address\"\r\n                name=\"keyword\"\r\n                value=\"\"\r\n              />\r\n              <a href=\"\" className=\"btn\">\r\n                Get updates\r\n              </a>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Categories;\r\n","H:\\99 Office Work\\Logic crypto\\logic_crypto\\src\\screens\\Invest.js",["362","363","364"],"import React from \"react\";\r\nimport Carousel from \"../components/Carousel\";\r\n\r\nconst Invest = () => {\r\n  return (\r\n    <>\r\n      <div class=\"container-fluid crypto-container\">\r\n        <div class=\"row banner\">\r\n          <div class=\"col-md-6\">\r\n            <div class=\"banner-text\">\r\n              <h1>Invest In Us</h1>\r\n              <p>\r\n                Our mission is the democratize access to investment\r\n                opportunities through automated trading. You can join the\r\n                exciting journey and make a huge difference.\r\n              </p>\r\n              <a href=\"\" class=\"btn\">\r\n                Join Now\r\n              </a>\r\n            </div>\r\n          </div>\r\n          <div class=\"col-md-6\">\r\n            <div class=\"banner-image\">\r\n              <img src=\"files/images/automated/banner-image.jpg\" alt=\"\" />\r\n            </div>\r\n          </div>\r\n          <div class=\"col-md-12 invest\">\r\n            <div class=\"payments\">\r\n              <h2>Access to a Variety of Exclusive Rewards</h2>\r\n            </div>\r\n            <div class=\"row\">\r\n              <div class=\"col-md-4\">\r\n                <p>\r\n                  Exclusive entrance to investor community on Slack and can\r\n                  shape the product with your feedback.\r\n                </p>\r\n              </div>\r\n              <div class=\"col-md-4\">\r\n                <p>\r\n                  Three-month free membership to the Hobbyist Plan to use\r\n                  dealing automation as complete as you require\r\n                </p>\r\n              </div>\r\n              <div class=\"col-md-4\">\r\n                <p>\r\n                  Own a part of Logic Crypto as an early-stage investor and\r\n                  enter an interesting London-based shaping the Future of\r\n                  Trading\r\n                </p>\r\n              </div>\r\n              <div class=\"col-md-12 pnote\">\r\n                <p>\r\n                  Please note: The content of this promotion has not been\r\n                  approved by an authorised person within the meaning of the\r\n                  Financial Services and Markets Act 2000. Investors should\r\n                  carry out their own due diligence and take professional advice\r\n                  where necessary.\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      {/* <!-- Banner Section --> */}\r\n      <d