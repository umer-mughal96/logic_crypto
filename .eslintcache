v>\n    </footer>\n  );\n};\n\nexport default Footer;\n","/Users/umermughal/Umer's Work/Office Work/logic_crypto/src/reducers/exchange.js",["252"],"import * as exchangeConstants from \"../actions/exchange/constants\";\n\nconst iniitialState = {\n  exLoading: false,\n  exchanges: null,\n};\n\nexport const Exchange = (state = iniitialState, action) => {\n  const { type, payload } = action;\n  switch (action.type) {\n    case exchangeConstants.SET_EXCHANGE_LOADING:\n      return {\n        ...state,\n        exLoading: true,\n      };\n\n    case exchangeConstants.CONNECT_EXCHANGE_SUCCESS:\n      return {\n        ...state,\n        exchanges: payload,\n        exLoading: false,\n      };\n\n    case exchangeConstants.CONNECT_EXCHANGE_FAIL:\n      return {\n        ...state,\n        exLoading: false,\n      };\n\n    case exchangeConstants.GET_EXCHANGES_SUCCESS:\n      return {\n        ...state,\n        exchanges: payload,\n        exLoading: false,\n      };\n\n    case exchangeConstants.DELETE_USER_EXCHANGE_SUCCESS:\n      return {\n        ...state,\n        exchanges: {\n          ...state.exchanges,\n          exchanges: state.exchanges.exchanges.filter(\n            (exc) => exc._id !== payload\n          ),\n        },\n        exLoading: false,\n      };\n\n    default:\n      return state;\n  }\n};\n","/Users/umermughal/Umer's Work/Office Work/logic_crypto/src/screens/Enthuasists.js",["253","254","255","256","257","258","259","260","261","262","263","264","265","266","267","268","269","270","271","272","273"],"import React from \"react\";\nimport Carousel from \"../components/Carousel\";\n\nconst Enthuasists = () => {\n  return (\n    <div>\n      <div className=\"container-fluid\">\n        <div className=\"row banner\">\n          <div className=\"col-md-6\">\n            <div className=\"banner-text\">\n              <h1>An A-Team of Crypto Enthusiasts That Love Trading</h1>\n              <p>\n                Logiccrypto is the smart assistant for crypto currency trading,\n                allowing you to take full control of your trading while being\n                able to fight back hedge funds and automated bots\n              </p>\n              <a href=\"#\" className=\"facebook\">\n                <i className=\"fab fa-facebook-square mr-1\"></i>\n              </a>\n              <a href=\"#\" className=\"twitter\">\n                <i className=\"fab fa-twitter-square mr-1\"></i>\n              </a>\n              <a href=\"#\" className=\"instagram\">\n                <i className=\"fab fa-instagram\"></i>\n              </a>\n              <br />\n              <a href=\"\" className=\"btn\">\n                Start for free\n              </a>\n            </div>\n          </div>\n          <div className=\"col-md-6\">\n            <div className=\"banner-image\">\n              <img src=\"files/images/automated/banner-image.jpg\" alt=\"\" />\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"container-fluid\">\n        <div className=\"row\">\n          <div className=\"col-md-12 p-0 enthusiasts\">\n            <h2>\n              \"We are a team of blockchain and crypto enthusiasts who found that\n              trading crypto currencies is unnecessarily complicated\"\n            </h2>\n            <Carousel/>\n            <h2>\n              We’ve had the pleasure of working with over 10+ amazing crypto\n              partners for our public alpha, including\n            </h2>\n          </div>\n        </div>\n      </div>\n      <div className=\"container-fluid coinrule\">\n        <div className=\"row team\">\n          <div className=\"col-md-12\">\n            <h2>Meet the Coinrule Team</h2>\n            <p>\n              We have the pleasure of working with fantastic advisors with\n              diverse backgrounds, from academia to capital markets\n            </p>\n          </div>\n          <div className=\"col-md-3\">\n            <div className=\"