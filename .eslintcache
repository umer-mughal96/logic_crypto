      <div className=\"status-toggle crypto-stats\">\n                                          <p>Rule errors</p>\n                                          <label className=\"switch\">\n                                            <input type=\"checkbox\" checked=\"\" />\n                                            <span className=\"slider round\"></span>\n                                          </label>\n                                        </div>\n                                      </div>\n                                      <div className=\"form-group\">\n                                        <div className=\"status-toggle crypto-stats\">\n                                          <p>Rule finished</p>\n                                          <label className=\"switch\">\n                                            <input type=\"checkbox\" checked=\"\" />\n                                            <span className=\"slider round\"></span>\n                                          </label>\n                                        </div>\n                                      </div>\n                                      <div className=\"form-group\">\n                                        <div className=\"status-toggle crypto-stats\">\n                                          <p>Demo rules</p>\n                                          <label className=\"switch\">\n                                            <input type=\"checkbox\" />\n                                            <span className=\"slider round\"></span>\n                                          </label>\n                                        </div>\n                                      </div>\n                                    </form>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"col-md-12 setting-spacing\">\n          